# PayFlex backend configuration — Stellar-only architecture.
# Copy to .env and fill in. Never commit the real .env file.
#
# There are no anchor/treasury/provider credentials here: this build has no
# fiat rail and no KYC provider at all (see docs/fiat-kyc-gap.md). When a
# real provider is plugged in later, its credentials belong in THIS file
# as clearly-named variables — never hardcoded anywhere else.

NODE_ENV=development
PORT=3000

# --- App database ------------------------------------------------------------
DATABASE_URL=postgresql://payflex:payflex@localhost:5432/payflex?schema=public

# --- Cache/session ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API authentication --------------------------------------------------------
# Signs access/refresh/bootstrap JWTs — see src/auth/ and
# src/token/token.service.ts. Any long random string; rotating it
# invalidates every issued token immediately (every user gets logged out).
# Generate one with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me

# --- QR Pay / PayTag / links (HMAC-signed tokens) ------------------------------
# Shared secret for short-lived QR tokens, split-bill QRs, and send-via-link
# share tokens so they can't be tampered with in transit. Any long random
# string; rotate freely (it only invalidates in-flight, unscanned QR codes).
# Generate one with:
#   openssl rand -hex 32
QR_SIGNING_SECRET=dev-only-insecure-secret-change-me

# --- Stellar network -----------------------------------------------------------
# The ONLY payment/settlement rail. Defaults to testnet with no config
# needed. Mainnet requires explicitly setting STELLAR_NETWORK=mainnet AND
# STELLAR_HORIZON_URL — this is a deliberate business/compliance decision,
# never a silent default, because mainnet involves real, irreversible funds.
# Leave STELLAR_HORIZON_URL / STELLAR_FRIENDBOT_URL blank on testnet to use
# the SDF defaults.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=
STELLAR_FRIENDBOT_URL=
