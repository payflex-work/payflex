// PayFlex app database schema — STELLAR-ONLY architecture.
//
// The previous banking layer has been removed entirely; Stellar is the sole
// blockchain, payment, and settlement layer. Every user is a non-custodial Stellar account whose
// key lives only on their device (see app/lib/stellar/stellar_key_service.dart).
// The backend NEVER holds user key material and NEVER builds or signs user
// transactions — it records and indexes what the app has already submitted to
// Horizon, resolves directory entries (PayTag), and escrows NOTHING on its own
// books (send-via-link uses native on-chain claimable balances, not a
// PayFlex-held account).
//
// HARD GATE (see docs/fiat-kyc-gap.md): `identityVerified` and `fiatCapable`
// default false and NO code path in this repository can set them true. The
// columns exist so a future IIdentityVerificationProvider / IFiatRailProvider
// implementation has somewhere to write its decision — until then every
// feature that would need verified identity or real fiat movement checks
// these flags and refuses, loudly.
//
// Migration note: the previous architecture's tables (SmartWallet, KycProfile,
// RailOnboarding, TransferProposal, AgentTransaction, LoanApplication,
// SavingsGoal, ClaimableLink, Safebox/Member/Transaction as they were) were
// exported to backend/archive/legacy-*/ by scripts/export-legacy-archive.ts
// before being dropped by the stellar_only migration. Nothing here reads
// that archive; it is a historical record only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phoneNumber String   @unique

  // The user's non-custodial Stellar account — the PRIMARY account for the
  // whole app. This is the PUBLIC key (G...); the secret seed never leaves
  // the device and is never stored, sent, or logged anywhere server-side.
  // Unique-but-nullable: a row is provisioned during onboarding before the
  // app finishes generating/confirming the keypair on-device.
  stellarPublicKey String? @unique

  // Whether the on-device keypair has been generated AND the account
  // activated on-chain (funded — Friendbot on testnet, min-balance payment
  // on mainnet later). App-layer state, verified against Horizon.
  stellarAccountActivated Boolean @default(false)

  // ---------- HARD GATE — read docs/fiat-kyc-gap.md before touching ----------
  // identityVerified: only a real IIdentityVerificationProvider may ever set
  //   this true. There is deliberately NO setter anywhere in this codebase.
  // fiatCapable: only a real IFiatRailProvider may ever set this true.
  //   Same rule.
  // Features that require verified identity (agent mode) or real fiat rails
  // (card, betting funding, deposits/withdrawals) check these flags and
  // refuse with a clear message. They must never proceed silently.
  identityVerified Boolean @default(false)
  fiatCapable      Boolean @default(false)
  // ---------------------------------------------------------------------------

  // Agent mode is PAUSED until both a fiat rail exists and identity
  // verification is real (an agent handles physical cash — that is the
  // hard-gate case, not a UI nicety). The flag is kept so the future
  // plug-in has its home; AgentService refuses to flip it while
  // identityVerified is false.
  isAgent Boolean @default(false)

  // Admin access — NOT self-service: only an existing admin can promote
  // another user (AdminService.setAdminStatus, AdminGuard-protected), and
  // the very first admin is bootstrapped out-of-band via
  // `npm run provision:admin` (see scripts/provision-admin.ts), never
  // through a public endpoint.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payTag           PayTag?
  transferRecords  TransferRecord[]
  linksSent        LinkRecord[]     @relation("LinksSent")
  linksClaimed     LinkRecord[]     @relation("LinksClaimed")
  splitBillsCreated          SplitBill[]
  splitBillContributions     SplitBillContributor[]
  standingPlans              StandingPlan[]
  refreshTokens              RefreshToken[]
}

// PayFlex's own @handle -> user directory. Resolves a tag to the recipient's
// stellarPublicKey; the actual payment is built and signed entirely on the
// sender's device and submitted to Horizon — the backend only records the
// result afterward.
model PayTag {
  id        String   @id @default(uuid())
  tag       String   @unique
  appUserId String   @unique
  appUser   AppUser  @relation(fields: [appUserId], references: [id])
  createdAt DateTime @default(now())
}

// One row per payment the app CONFIRMS on-chain (after Horizon accepts the
// transaction the device built and signed). Not a source of truth for
// balances — Horizon is — but the app's own transaction list, with PayFlex
// metadata (which QR token / PayTag / split bill produced this payment)
// that the chain does not carry. amount/currency mirror the payment
// operation exactly as submitted.
model TransferRecord {
  id             String   @id @default(uuid())
  appUserId      String
  appUser        AppUser  @relation(fields: [appUserId], references: [id])

  stellarTxHash  String   @unique
  fromPublicKey  String
  toPublicKey    String
  amount         String
  assetCode      String   // "XLM" or an issued asset code
  assetIssuer    String?

  // PayFlex context (never part of the chain payload):
  kind           String   @default("TRANSFER") // TRANSFER | QR_PAY | OFFLINE_REDEMPTION | SPLIT_BILL | STANDING_PLAN | LINK_CLAIM
  qrTokenRef     String?
  splitBillId    String?
  standingPlanId String?
  offlineAuthorizationId String?
  memo           String?

  createdAt DateTime @default(now())

  @@index([appUserId, createdAt])
}

// Standing Plans: recurring payments to a chosen recipient. The scheduler
// marks a payment DUE; execution still requires the user's live on-device
// signature (non-custodial, no delegated debit on Stellar) — the app
// surfaces due payments and walks the user through signing. The stored
// plan is the intent + record; the chain is the execution.
model StandingPlan {
  id        String  @id @default(uuid())
  appUserId String
  appUser   AppUser @relation(fields: [appUserId], references: [id])

  name          String
  assetCode     String // "XLM" or issued asset
  assetIssuer   String?
  amount        String
  frequency     String // "DAILY" | "WEEKLY" | "MONTHLY"
  toPublicKey   String?
  toPayTag      String?
  description   String?
  nextPaymentAt DateTime
  status        String @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  totalPaid     String @default("0")

  payments StandingPlanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StandingPlanPayment {
  id             String       @id @default(uuid())
  standingPlanId String
  standingPlan   StandingPlan @relation(fields: [standingPlanId], references: [id])

  amount         String
  status         String    @default("DUE") // DUE | RECORDED | FAILED
  stellarTxHash  String?
  dueAt          DateTime
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Split bills remain pure orchestration: the bill tracks who owes what; each
// contributor's payment is an independent on-device Stellar payment recorded
// here via TransferRecord (splitBillId set). A shared, HMAC-signed QR
// (HmacTokenService) carries the splitBillId so a scanning contributor's app
// can look up their own share.
model SplitBill {
  id               String  @id @default(uuid())
  creatorAppUserId String
  creator          AppUser @relation(fields: [creatorAppUserId], references: [id])

  description   String
  assetCode     String
  totalAmount   String
  status        String @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED

  contributors SplitBillContributor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Send-via-link, non-custodial: the sender's app creates an on-chain
// CLAIMABLE BALANCE (funds never sit in a PayFlex-owned account — the chain
// escrows them), then registers the claimable balance id here. Claiming is
// the recipient's own on-chain claimClaimableBalance operation; the backend
// only verifies the claim happened and marks the record. The old
// treasury-escrow liability surface is gone by construction.
model LinkRecord {
  id              String  @id @default(uuid())
  senderAppUserId String
  sender          AppUser @relation("LinksSent", fields: [senderAppUserId], references: [id])

  tokenHash          String  @unique // HMAC of the shareable token — the raw token never lands here
  claimableBalanceId String? @unique // set once the sender's app reports the on-chain CB id
  amount             String
  assetCode          String
  assetIssuer        String?
  status             String  @default("PENDING_CB") // PENDING_CB | FUNDED | CLAIMED | EXPIRED

  claimedByAppUserId String?
  claimedBy          AppUser? @relation("LinksClaimed", fields: [claimedByAppUserId], references: [id])
  claimedAt          DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Registry of deployed Safebox Soroban contracts. The on-chain contract is
// the source of truth for ownership, admins (max 3, enforced on-chain),
// balances, and its contribution/withdrawal ledger — see
// backend/contracts/safebox. This table only maps a contract id to product
// metadata (name/description) and who registered it, so the app can list
// "my safeboxes" without an RPC round trip per row.
model SafeboxRegistry {
  id             String  @id @default(uuid())
  contractId     String  @unique // Soroban contract address (C...)
  ownerPublicKey String // mirrors get_owner(); verified against the chain on read
  name           String
  description    String
  kind           String  @default("SAFEBOX") // SAFEBOX | SAVINGS_GOAL (a personal safebox backs each savings goal)
  closed         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SplitBillContributor {
  id            String    @id @default(uuid())
  splitBillId   String
  splitBill     SplitBill @relation(fields: [splitBillId], references: [id])

  appUserId     String
  appUser       AppUser   @relation(fields: [appUserId], references: [id])
  shareAmount   String
  status        String    @default("PENDING") // PENDING | RECORDED
  stellarTxHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([splitBillId, appUserId])
}

// Post-launch hardening: API authentication (see src/auth/). Refresh
// tokens are recorded by their jti (not the token itself) so one can be
// revoked (e.g. "log out this device") without needing to blacklist a
// JWT string — checking a row exists and isn't revoked is enough.
model RefreshToken {
  id        String   @id @default(uuid())
  appUserId String
  appUser   AppUser  @relation(fields: [appUserId], references: [id])
  jti       String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
